# Copy to .cursor/whatsapp.env and fill in your values.
# Get WhatsApp message API key: message CallMeBot bot "I allow callmebot to send me messages"
# Get phone call API key: message CallMeBot bot "I allow callmebot to call me"

CALLMEBOT_PHONE=+1234567890
CALLMEBOT_API_KEY=your_whatsapp_api_key
# Optional separate call key if different from WhatsApp message key
# CALLMEBOT_CALL_API_KEY=your_call_api_key

# message | call | phone | both
WHATSAPP_NOTIFY_MODE=message

# Optional voice language for phone calls (example: en-US-Standard-B)
# CALLMEBOT_CALL_LANG=en-US-Standard-B

# Comma-separated allowed sender numbers (country code, digits only ok).
# Leave empty to accept from any private chat that messages the linked account.
WHATSAPP_ALLOWED_NUMBERS=1234567890
